# Server
PORT=8080
BASE_URL=https://your-domain.example
SESSION_SECRET=please_change_me

# Database
DATABASE_FILE=./data/navalivay.db

# Admin
ADMIN_CONFIG=./data/admin.json

# Telegram
BOT_TOKEN={{TELEGRAM_BOT_TOKEN}}
# Имя бота без @ (публично отдаётся в /api/settings; для bot.js: кнопки web_app с t.me?mode=compact)
MANAGER_USERNAME=@dmitriy_mityuk
TELEGRAM_BOT_USERNAME=your_bot_username
# Короткое имя Mini App из @BotFather (как в ссылке t.me/бот/ИМЯ). Включает формат direct link для compact.
TELEGRAM_MINI_APP_SHORT_NAME=

# Прокси для Bot API (на RU-хостинге Telegram режется напрямую). Формат
# http://user:pass@host:port. Если не задан — fetch к api.telegram.org идёт
# напрямую. См. server/utils/telegram-business-api.js, docs/userbot-mtproto.md.
TELEGRAM_HTTP_PROXY=

# Userbot (MTProto-клиент от лица аккаунта менеджера, см. docs/userbot-mtproto.md).
# Получаются на https://my.telegram.org → API development tools.
# КРИТИЧЕСКИ СЕКРЕТНЫ — никогда не коммитим в git.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Опционально: общий секрет между api-процессом и userbot для X-Userbot-Secret
# заголовка в локальном HTTP. Защита от случайного локального RCE до userbot.
USERBOT_SECRET=