# Production Server Configuration
PORT=8080
BASE_URL=https://navalivay.store
NODE_ENV=production

# Security
SESSION_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИНИМУМ_32_СИМВОЛА

# Database
DATABASE_FILE=./data/navalivay.db

# Admin
ADMIN_CONFIG=./data/admin.json

# Telegram
BOT_TOKEN={{TELEGRAM_BOT_TOKEN}}
MANAGER_USERNAME=@dmitriy_mityuk
# Прокси на VPS (хостер режет api.telegram.org). Формат http://user:pass@host:port.
TELEGRAM_HTTP_PROXY={{TELEGRAM_HTTP_PROXY}}

# Userbot (MTProto, см. docs/userbot-mtproto.md). Получаются на my.telegram.org.
TELEGRAM_API_ID={{TELEGRAM_API_ID}}
TELEGRAM_API_HASH={{TELEGRAM_API_HASH}}
USERBOT_SECRET={{USERBOT_SECRET}}

# Logging
LOG_LEVEL=info
